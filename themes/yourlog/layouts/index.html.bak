{{ define "main" }}

<section class="hero">
  {{ with site.Params.badge }}<p class="badge">{{ . }}</p>{{ end }}
  <h1>{{ with site.Params.heroAccent }}<span class="hero-accent">{{ . }}</span>{{ end }}{{ site.Params.heroTitle }}</h1>
  <p class="lead">{{ site.Params.heroLead }}</p>
  {{ with site.Params.heroPoints }}
  <ul class="hero-points">
    {{ range . }}<li>{{ . }}</li>{{ end }}
  </ul>
  {{ end }}
</section>

{{ with site.Params.startURL }}
<a class="start-card" href="{{ . | relURL }}">
  <span class="start-label">{{ site.Params.startLabel }}</span>
  <span class="start-title">{{ site.Params.startTitle }}</span>
  <span class="start-desc">{{ site.Params.startDesc }}</span>
  <span class="start-arrow" aria-hidden="true">→</span>
</a>
{{ end }}

{{ with site.Params.steps }}
<section class="steps">
  <p class="section-label">{{ site.Params.stepsLabel }}</p>
  <ol class="steps-list">
    {{ range . }}
    <li class="step">
      <span class="step-num">{{ .num }}</span>
      <div class="step-body">
        <h3>{{ .title }}</h3>
        <p>{{ .desc }}</p>
        {{ with .links }}
        <div class="step-links">
          {{ range . }}<a href="{{ .url | relURL }}">{{ .label }}</a>{{ end }}
        </div>
        {{ end }}
      </div>
    </li>
    {{ end }}
  </ol>
</section>
{{ end }}

{{ with site.Params.helpURL }}
<p class="help"><a href="{{ . | relURL }}">{{ site.Params.helpText }}</a></p>
{{ end }}

<section class="articles">
  <p class="section-label">最近の記事</p>
  <ul class="article-list">
    {{ range first 5 (where site.RegularPages "Section" "posts") }}
    <li>
      <a href="{{ .RelPermalink }}">{{ .Title }}</a>
      <time class="mono" datetime="{{ .Date.Format "2006-01-02" }}">{{ .Date.Format "01.02" }}</time>
    </li>
    {{ end }}
  </ul>
</section>

{{ end }}
